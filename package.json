{
  "name": "gold_front",
  "version": "1.9.1",
  "description": "Front for service Gold",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,json}\"",
    "link:sunny": "npm link @happykiller/sunny-ui",
    "up:sunny": "npm install @happykiller/sunny-ui@latest --force",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "npm run codegen && git diff --exit-code -- src/gql",
    "check": "npm run lint && npm run build && npm test"
  },
  "author": "Fabrice Rosito<fabrice.rosito@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/montserrat": "^5.2.6",
    "@fontsource/roboto": "^5.2.6",
    "@fontsource/roboto-mono": "^5.3.0",
    "@happykiller/sunny-ui": "^2.2.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/x-date-pickers": "^9.11.0",
    "@passwordless-id/webauthn": "^2.3.0",
    "dayjs": "^1.11.13",
    "framer-motion": "^12.43.0",
    "highcharts": "^13.0.0",
    "highcharts-react-official": "^3.2.3",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.0",
    "lodash.merge": "^4.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.6.2",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/lodash.merge": "^4.6.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.9.0",
    "graphql": "^16.14.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
