{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "jsx": "react-jsx",

    // Vite résout les modules comme un bundler, pas comme Node.
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,

    // C'est esbuild qui transpile ; TypeScript ne sert plus qu'à vérifier les
    // types (`npm run build` lance `tsc --noEmit` avant `vite build`).
    "noEmit": true,

    // Types de l'environnement Vite : import.meta.env, import de fichiers .svg…
    // `node` s'y ajoute pour le harnais e2e et les fichiers de configuration,
    // qui tournent hors navigateur (process.env, node:fs).
    "types": ["vite/client", "node"],

    "skipLibCheck": false,

    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@presentation/*": ["src/presentation/*"],
      "@usecase/*": ["src/usecase/*"],
      "@service/*": ["src/service/*"],
      "@pages/*": ["src/pages/*"],
      "@components/*": ["src/presentation/*"],
      "@usecases/*": ["src/usecase/*"],
      "@services/*": ["src/service/*"],
      "@stores/*": ["src/stores/*"]
    }
  },
  // `e2e` et `playwright.config.ts` sont inclus délibérément : le harnais n'est
  // joué qu'à la demande, donc sans cette vérification de types au build il
  // dériverait en silence jusqu'au jour où on en a besoin.
  "include": ["src", "vite.config.ts", "playwright.config.ts", "e2e"],
  "exclude": ["node_modules", "dist"]
}
